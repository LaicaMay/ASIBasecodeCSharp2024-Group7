@model ExpenseTracker.Data.Models.Balance
@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Expense Summary";

    var extCatandMon = ViewData["ExpMonthAndCateg"];
    var curExpMon = ViewData["curMonthExp"];
    var remBals = ViewData["RemainingBal"];

}

<link rel="stylesheet" href="~/css/expsummary.css"/>

<div class="main-container">
    <div class="expenses">
        <div class="topbarinfo">
            <div class="title-filter-group">
                <h1>Expenses Summary</h1>
                
            </div>
            <div class="balance-monthYear">
                <select>
                    @foreach (var balance in ViewBag.BalanceDate)
                    {
                        <option value="@balance.Value">@balance.Text</option>
                    }
                </select>
            </div>
        </div>
        <div class="expensecontents">
            <div class="expenseitems">
                <h1 id="total-exp-cur-month">Php 0.00</h1>
                <p>Total Expenses</p>
                <p id="month-selected">Month</p>
            </div>
            <div class="expenseitems">
                <h1 id="high-exp-cur-month">Php 0.00</h1>
                <p>Largest Expense</p>
                <p id="high-exp-cur-month-name"></p>
            </div>
            <div class="expenseitems">
                <h1 id="rem-bal-cur-month">Php0.00</h1>
                <p>Remaining Budget</p>
                <p id="month-selected">Month</p>
            </div>
        </div>
    </div>
    <div class="charts">
        <div class="pie-chart" id="changeData">
            <div class="title-filter-group">
                <h3>Current Month Expenses</h3>
            </div>
            <div class="pie-container">
                <canvas id="pie-chart" width="400" height="400"></canvas>
            </div>
        </div>
        <div class="line-graph">
            <div class="title-filter-group">
                <h3>Expense Trend</h3>
            </div>
            <div class="line-container">
                <canvas id="line-graph" width="800" height="400"></canvas>
            </div>
        </div>
    </div>
    <div class="button-container">
        <button id="generateReportButton">Generate Report</button>
    </div>
</div>

<!-- Modal Structure -->
<div id="expenseModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Expense Details</h2>
            <button id="closeModal" class="close-btn">&times;</button>
        </div>
        <div class="modal-body">
            <table id="expensestable" class="table">
                <thead>
                    <tr>
                        <th>Expense Name</th>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                   
                </tbody>
            </table>
        </div>
        <div class="modal-footer">
            <button id="saveToPdfButton" class="modal-btn">Save to PDF</button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.23/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/chart.js"></script>
<script src="/js/expsummary.js"></script>

<script>
    const allexp = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(extCatandMon));
    const allexpcur = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(curExpMon));
    const remBal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(remBals));

    document.addEventListener("DOMContentLoaded", function () {
        const pieLabels = allexpcur.map(item => item[0]);
        const pieData = allexpcur.map(item => item[1]);

        const pieDatasets = [{
            data: pieData,
            backgroundColor: generateRandomColors(pieLabels.length),
            hoverOffset: 4
        }];

        createChart(pieLabels, pieDatasets, 'pie-chart', 'pie');

        updateMonthLabels();
        createLineChart(allexp);

        const totalExpenses = calculateTotalExpenses(allexpcur);
        const largestExpense = findLargestExpense(allexpcur);

        document.getElementById('total-exp-cur-month').textContent = formatCurrency(totalExpenses);
        document.getElementById('high-exp-cur-month').textContent = formatCurrency(largestExpense.amount);
        document.getElementById('high-exp-cur-month-name').textContent = `${largestExpense.name} Expense`;
        document.getElementById('rem-bal-cur-month').textContent = formatCurrency(remBal);
    });

   

</script>


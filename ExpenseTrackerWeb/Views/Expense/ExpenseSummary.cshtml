@{
    Layout = "_MainLayout";
    var months = (string[])ViewData["Months"];
    var barChartDatasets = (List<object>)ViewData["BarChartDatasets"];
    var pieChartLabels = (string[])ViewData["PieChartLabels"];
    var pieChartData = (double[])ViewData["PieChartData"];
}

<link rel="stylesheet" href="/css/expensesummary.css">
<link rel="stylesheet" href="/css/chart.css">

<div class="main-2">
    <div class="expenses">
        <div class="topbarinfo">
            <div class="title-filter-group">
                <h1>Expenses Summary</h1>
                <img src="~/images/backgroundImage/ic_filter.png" id="filterContent" contextmenu="filterButton" />
            </div>
            <h4 id="currentDateSpan">January 1 - September 5</h4>
        </div>
        <!-- Expense Details -->
        <div class="expensecontents">
            <div class="expenseitems">
                <h1>Php 1000.00</h1>
                <p>Total Expenses</p>
            </div>
            <div class="expenseitems">
                <h1>Php 2000.00</h1>
                <p>Total Income</p>
            </div>
            <div class="expenseitems">
                <h1>Php 500.00</h1>
                <p>Savings</p>
            </div>
        </div>
    </div>
    <div class="charts">
        <!-- Pie Chart -->
        <div class="pie-chart" id="changeData">
            <div class="title-filter-group">
                <h3>Total Balance vs. Expenses</h3>
                <img src="~/images/backgroundImage/ic_filter.png" id="piefilterContent" contextmenu="filterButton" />
            </div>
            <div class="pie-container">
                <canvas id="pie-chart"></canvas>
            </div>
        </div>
        <!-- Line Graph -->
        <div class="line-graph">
            <div class="title-filter-group">
                <h3>Expense Trend</h3>
                <img src="~/images/backgroundImage/ic_filter.png" id="linefilterContent" contextmenu="filterButton" />
            </div>
            <div class="line-container">
                <canvas id="line-graph"></canvas>
            </div>
        </div>
    </div>
    <div class="button-container">
        <button id="generateReportButton">Generate Report</button>
    </div>
</div>

<script src="~/js/expensesummary.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/chart.js"></script>

<script>
    const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(months));
    const barChartDatasets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(barChartDatasets));

    const pieChartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pieChartLabels));
    const pieChartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pieChartData));

    createChart(months, barChartDatasets, "line-graph", "bar");

    createChart(pieChartLabels, [{
        data: pieChartData,
        backgroundColor: ['#4CAF50', '#FF5722'], // Colors for balance and expenses
        borderWidth: 1
    }], "pie-chart", "pie");
</script>


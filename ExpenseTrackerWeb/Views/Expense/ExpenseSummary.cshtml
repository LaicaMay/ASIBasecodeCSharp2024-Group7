@{
    Layout = "_MainLayout";
}
    <link rel="stylesheet" href="/css/expensesummary.css">
    <link rel="stylesheet" href="/css/chart.css">
    <script src="https://d3js.org/d3.v7.min.js"></script>

    <div class="main-2">
    <div class="expenses">
        <div class="topbarinfo">
            <div class="title-filter-group">
                <h1>
                    Expenses Summary</h2>
                    <img src="~/images/backgroundImage/ic_filter.png" id="filterContent" contextmenu="filterButton" />
            </div>

            <h4 id="currentDateSpan">January 1 - September 5</h4>
        </div>
        <!-- List Container-->
        <div class="expensecontents">
            <!-- List Items (foreach cs)-->
            <div class="expenseitems">
                <h1>Php 1000.00</h1>
                <p>Total Expenses</p>
            </div>
            <div class="expenseitems">
                <h1 id="">Php 1000.00</h1>
                <p>Total Expenses</p>
            </div>
            <div class="expenseitems">
                <h1>Php 1000.00</h1>
                <p>Total Expenses</p>
            </div>
            <!-- List Items-->
        </div>
        <!-- List Container-->
    </div>
    <div class="charts">
        <div class="pie-chart" id="changeData">
            <div class="title-filter-group">
                <h3 id="title"></h3>
                <img src="~/images/backgroundImage/ic_filter.png" id="piefilterContent" contextmenu="filterButton" />
            </div>
            <div class="pie-container">
                <canvas id="pie-chart"></canvas>
            </div>
        </div>
        <div class="line-graph">
            <div class="title-filter-group">
                <h3>Expense Trend</h3>
                <img src="~/images/backgroundImage/ic_filter.png" id="linefilterContent" contextmenu="filterButton" />
            </div>
            <div class="line-container">
                <canvas id="line-graph"></canvas>
            </div>
        </div>
    </div>
    <div class="button-container">
        <button id="generateReportButton">Generate Report</button>
    </div>
</div>


<!-- Sample Output Display -->
<div class="overlay" id="reportOverlay">
    <div class="overlay-content">
        <h2>Sample Expense Report</h2>
        <div class="content">
            <p><strong>Total Expenses:</strong> $5000</p>
            <p><strong>Grocery Expenses:</strong> $1500</p>
            <p><strong>School Expenses:</strong> $1000</p>
        </div>
        <div class="overlay-buttons">
            <button id="saveReportButton">Save</button>
            <button id="exitReportButton">Exit Report</button>
        </div>
    </div>
</div>
<!--  Sample Output Display -->
    </div>
        

    <script src="~/js/expensesummary.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/chart.js"></script>

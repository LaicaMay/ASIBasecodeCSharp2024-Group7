@{
    Layout = "_MainLayout";
    ViewData["Title"] = "Expense Summary";
    var months = ViewData["Months"] as string[] ?? Array.Empty<string>();
    var barChartDatasets = ViewData["BarChartDatasets"];
    var pieChartLabels = ViewData["PieChartLabels"] as string[] ?? Array.Empty<string>();
    var pieChartData = ViewData["PieChartData"] as double[] ?? Array.Empty<double>();
}

<link rel="stylesheet" href="/css/expsummary.css"/>

<div class="main-2">
    <div class="expenses">
        <div class="topbarinfo">
            <div class="title-filter-group">
                <h1>Expenses Summary</h1>
                <img src="/images/iconVec/ic_filter.png" id="filterContent" contextmenu="filterButton" />
            </div>
            <h4 id="currentDateSpan">January 1 - September 5</h4>
        </div>
        <div class="expensecontents">
            <div class="expenseitems">
                <h1>Php 1000.00</h1>
                <p>Total Expenses</p>
            </div>
            <div class="expenseitems">
                <h1>Php 2000.00</h1>
                <p>Total Income</p>
            </div>
            <div class="expenseitems">
                <h1>Php 500.00</h1>
                <p>Savings</p>
            </div>
        </div>
    </div>
    <div class="charts">
        <div class="pie-chart" id="changeData">
            <div class="title-filter-group">
                <h3>LifeTime Balance vs. Expenses</h3>
                <img src="/images/iconVec/ic_filter.png" id="piefilterContent" contextmenu="filterButton" />
            </div>
            <div class="pie-container">
                <canvas id="pie-chart" width="400" height="400"></canvas>
            </div>
        </div>
        <div class="line-graph">
            <div class="title-filter-group">
                <h3>Expense Trend</h3>
                <img src="/images/iconVec/ic_filter.png" id="linefilterContent" contextmenu="filterButton" />
            </div>
            <div class="line-container">
                <canvas id="line-graph" width="800" height="400"></canvas>
            </div>
        </div>
    </div>
    <div class="button-container">
        <button id="generateReportButton">Generate Report</button>
    </div>
</div>

<!-- Modal Structure -->
<div id="expenseModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Expense Details</h2>
            <button id="closeModal" class="close-btn">&times;</button>
        </div>
        <div class="modal-body">
            <table id="expensestable" class="table table-bordered">
                <thead>
                    <tr>
                        <th class="padding">Expense Name</th>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
           
                </tbody>
            </table>
        </div>
        <div class="modal-footer">
            <button id="saveToPdfButton" class="modal-btn">Save to PDF</button>
        </div>
    </div>
</div>



<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/chart.js"></script>
<script src="/js/expsummary.js"></script>

<script>
    const userExpenses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["UserExpenses"]));
    const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(months));
    const barChartDatasets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(barChartDatasets));
    const pieChartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pieChartLabels));
    const pieChartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pieChartData));
    

    console.log({ months, barChartDatasets, pieChartLabels, barChartDatasets, userExpenses });
    

    createChart(months, barChartDatasets, "line-graph", "bar");
    createChart(pieChartLabels, [{
        data: pieChartData,
        backgroundColor: ['#4CAF50', '#FF5722'],
        borderWidth: 1
    }], "pie-chart", "pie");
</script>


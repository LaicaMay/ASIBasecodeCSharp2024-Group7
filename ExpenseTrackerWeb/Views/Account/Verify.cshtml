@model ExpenseTracker.Data.Models.CustomModels.VerifyViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SignUp</title>
    <link href="https://fonts.cdnfonts.com/css/circe-rounded" rel="stylesheet">
    <link href="~/css/landingsidebar.css" rel="stylesheet" />
    <link href="~/css/landingpheader.css" rel="stylesheet" />
    <link href="~/css/verfiy.css" rel="stylesheet" />
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/spinner.css" rel="stylesheet" />
</head>
<body>
    <header class="header-container">
        <div class="hamburger" id="hamburger">
            <img src="/images/sidebarImg/charm_menu-hamburger.svg" alt="" class="burger">
        </div>
        <div class="logo">
            <img src="~/images/ETlogo.svg" alt="Logo">
        </div>
        <div class="expense-tracker">
            <a href="#">ExpenseTracker</a>
        </div>
        <div class="landing-tags">
            <a href="@Url.Action("ExpenseTracker", "Home")">Home</a>
        </div>
        <div class="landing-tags">
            <a href="@Url.Action("WhyExpenseTracker", "Home")">Why ExpenseTracker?</a>
        </div>
        <div class="landing-tags">
            <a href="@Url.Action("OurTeam", "Home")">Our Team</a>
        </div>
        <form method="get" asp-controller="Account" asp-action="SignUp">
            <div>
                <button class="register-btn">
                    Register
                </button>
            </div>
        </form>
    </header>

    <nav class="sidebar" id="sidebar">
        <div class="logo-sidebar">
            <img src="images/logo/Logo.svg" alt="">
            <p>ExpenseTracker</p>
        </div>
        <div class="home">
            <a href="@Url.Action("ExpenseTracker", "Home")">Home</a>
        </div>
        <div class="why-expense">
            <a href="@Url.Action("WhyExpenseTracker", "Home")">Why ExpenseTracker?</a>
        </div>
        <div class="our-team">
            <a href="@Url.Action("OurTeam", "Home")">Our Team</a>
        </div>
        <div class="close-btn">
            <a href="javascript:void(0)" class="closebtn" id="close-btn">&times;</a>
        </div>
    </nav>

    <form asp-action="Verify" asp-controller="Account" method="post">
    <div class="login-container">
        <h3>Verify your Account</h3>
        <div style="display:flex; flex-direction: column; align-items: center; justify-content: center; position:relative">
            <input asp-for="ConfirmCode" type="text" style="padding-top: 10px;
                                                     padding-bottom: 10px;
                                                     padding-left: 35px;
                                                     width: 300px;
                                                     border-radius: 30px;
                                                     margin-top: 10px;"
            placeholder="Enter your code."/>    
        <div class="invalid-code">
             <span class="validation" asp-validation-for="ConfirmCode" class="text-danger" style="color:red;"></span>
        </div>
        </div>
        <button type="submit" style="padding-top: 10px;
                                     padding-bottom: 10px;
                                     width: 300px;
                                     border-radius: 30px;
                                     font-weight: bold;
                                     margin-top: 15px;
                                     font-size: 15px;
                                     background-color: #68BB69;">
            Submit
        </button>


        <div class="resendCode-cont">
        <a id="resendView">Resend new code?</a>
        </div>      
    </div>
    </form>   

    <div id="resend-new-cont" class="hide">
        <h3>Resend new code</h3>
        <input id="resend-email" type="email" placeholder="Your Email." />
        <button id="send-new-code">Send</button>
        <span id="resend-error-message"></span>
    </div>
    <div id="login-blur" class="hide"></div>
    @section Scripts {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.2/jquery.validate.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
    }
    <script src="~/js/resendcode.js"></script>
</body>
</html>
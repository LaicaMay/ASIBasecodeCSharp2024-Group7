@model ExpenseTracker.Data.Models.Balance
@using System.Security.Claims
<div class="balance-container" style="position: relative;">
    <div class="balance-monthYear">
        <select id="balance-dropdown">
            @foreach (var balance in ViewBag.BalanceDate)
            {
                <option data-budget-id="@balance.BalanceId"
                        data-totalbal="@balance.TotalBalance"
                        data-remainingbal="@balance.RemainingBalance"
                        data-balance-date="@balance.Text"
                        data-text-value="@balance.Value"
                        value="@balance.Text">@balance.Text
                </option>
            }
        </select>
    </div>
    <div class="expense">
        <p id="expense-category">Total Balance</p>
        <p id="expense-tag">PHP<input id="totalBalance" type="text" class="digital-input" placeholder="------------"
                   value="@String.Format("{0:N2}", Model.TotalBalance)" readonly>
        </p>
        @if (User.Identity.IsAuthenticated)
        {
            <p id="expense-user">@User.FindFirst(ClaimTypes.NameIdentifier)?.Value</p>
        }
        <div id="deduction"><button id="budget-btn" class="budgetBtn">Set Budget</button></div>
    </div>
    <div class="remaining-expense">
        <p id="remaining-expense-category">Remaining Balance</p>
        <p id="remaining-expense-tag">PHP<input id="remainingUserBalance" type="text" class="digital-input" placeholder="------------" value="@String.Format("{0:N2}", Model.RemainingBalance)" readonly></p>
        @if (User.Identity.IsAuthenticated)
        {
            <p id="remaining-expense-user">@User.FindFirst(ClaimTypes.NameIdentifier)?.Value</p>
        }
    </div>
</div>


<script>

    // Target string to exclude
    var excludeString = "Month Year"; // Replace with the desired "Month Year" string

    // Filter out options with data-balance-date equal to the target string
    var dropdown = document.getElementById('balance-dropdown');
    for (var i = dropdown.options.length - 1; i >= 0; i--) {
        var option = dropdown.options[i];
        var balanceDate = option.getAttribute('data-balance-date');
        if (balanceDate === excludeString) {
            dropdown.removeChild(option); // Remove matching option
        }
    }

    // Event listener for dropdown change
    dropdown.addEventListener('change', function () {
        var selectedOption = this.options[this.selectedIndex];
        var budget = selectedOption.getAttribute('data-budget-id');
        var date = selectedOption.getAttribute('data-balance-date');
        var totalBalance = selectedOption.getAttribute('data-totalbal');
        var remainingBalance = selectedOption.getAttribute('data-remainingbal');

        // Update modal content
        document.getElementById('budget-id').value = budget;
        document.getElementById('budget-total').innerText = totalBalance;
        document.getElementById('remain-budget').innerText = remainingBalance;
        document.getElementById('budget-date').innerText = date;

        // Show the modal
        var modal = document.getElementById('history-budget');
        var blur = document.getElementById('blur-budget');
        modal.classList.remove('hide');
        modal.classList.add('show');
        blur.classList.add('show');
        blur.classList.remove('hide');
    });

    // document.getElementById('balance-dropdown').addEventListener('change', function () {

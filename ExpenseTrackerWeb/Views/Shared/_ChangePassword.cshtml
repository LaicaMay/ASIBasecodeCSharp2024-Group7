@model ExpenseTracker.Data.Models.CustomModels.ChangePasswordModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExpenseTrackerWeb</title>
    <link href="https://fonts.cdnfonts.com/css/circe-rounded" rel="stylesheet">
    <link href="~/css/general.css" rel="stylesheet" />
    <link href="~/css/landingpheader.css" rel="stylesheet" />
    <link href="~/css/landingsidebar.css" rel="stylesheet" />
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/resetpass.css" rel="stylesheet" />
</head>
<body>
    <header class="header-container">   
    </header>
    <main style="position:absolute; top: 45%; left:50%; transform:translate(-50%, -50%);">
        <div class="resetPass">
            <h2>Reset Password</h2> 
            <input id="reset-userId" type="hidden" value="@Model.UserId"/>
            <input id="reset-token" type="hidden" value="@Model.Token"/>
            <div>
                <input id="reset-newPass" type="password" placeholder="New Password" required />            
            </div>
            <div>
                <input id="reset-confirmPass" type="password" placeholder="Confirm New Password" required />
            </div>
            <button id="reset-submit" type="button">Reset Password</button>                 
        </div>    
    </main>

    <div id="span-error-msg" class="hide">
        <img src="/images/loginImg/warning.svg" />
        <span id="error-resetPass"></span>
        <ul id="error-messages-list"></ul>
    </div>

    <div id="blur-resetPass" class="hide"></div>

    <div id="success-reset" class="hide">
        <img src="/images/iconVec/check.png"/>
        <h3>Password Reset Successfully.</h3>
        <p>Please check your mail for notification.</p>
        <a href="@Url.Action("Login", "Account")">Goto Login Page</a>
    </div>

    <div id="blur-resetSuccess" class="hide"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/resetpass.js"></script>
</body>
</html>




